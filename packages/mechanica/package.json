{
  "name": "mechanica",
  "version": "2.0.0-alpha.0",
  "description": "Build Vue 3 websites with a visual block editor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mechanica": "bin/mechanica.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    },
    "./editor": {
      "import": "./src/editor/editor.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mechanica/shared": "workspace:*",
    "@vue/compiler-sfc": "^3.5.38",
    "compact-json-schema": "^0.1.5",
    "estree-walker": "^3.0.3",
    "magic-string": "^0.30.21",
    "vuesix": "^1.0.48",
    "vuewrite": "^1.0.1"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^25.0.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.38"
  }
}
