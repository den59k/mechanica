{
  "name": "mechanica",
  "version": "2.0.0-alpha.14",
  "description": "Build Vue 3 websites with a visual block editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.letary.ru/den59k/mechanica.git"
  },
  "keywords": [
    "vue",
    "vite",
    "page-builder",
    "visual-editor",
    "blocks",
    "cms",
    "ssg"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "tag": "next"
  },
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "mechanica": "bin/mechanica.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/types/vite/index.d.ts",
      "import": "./dist/plugin.js"
    },
    "./editor": {
      "import": "./dist/editor.js"
    },
    "./editor.css": "./dist/editor.css",
    "./composer": {
      "types": "./dist/types/editor/composer/composer.d.ts",
      "import": "./dist/composer.js"
    },
    "./widgets": {
      "types": "./dist/types/editor/widget-api.d.ts",
      "import": "./dist/widgets.js"
    }
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && vite build -c vite.node.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "mechanica-shared": "workspace:*",
    "@vue/compiler-sfc": "^3.5.38",
    "compact-json-schema": "^0.1.5",
    "estree-walker": "^3.0.3",
    "magic-string": "^0.30.21",
    "vuesix": "^1.0.48",
    "vuewrite": "^1.4.1"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^25.0.1",
    "sass": "^1.101.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.38"
  }
}
