{
  "name": "mechanica-shared",
  "version": "2.1.0-beta.6",
  "description": "DOM-free types, schema helpers and page-generation core shared across Mechanica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/den59k/mechanica.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./page-format": {
      "types": "./dist/types/page-format.d.ts",
      "import": "./dist/page-format.js"
    },
    "./block-format": {
      "types": "./dist/types/block-format.d.ts",
      "import": "./dist/block-format.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "compact-json-schema": "^0.1.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
